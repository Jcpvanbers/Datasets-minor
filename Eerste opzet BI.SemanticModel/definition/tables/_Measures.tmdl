table _Measures
	lineageTag: c61331a2-85d5-4d96-af89-e669991ddb7e

	measure Revenue = sum(Sales[Revenue excl. returns])
		displayFolder: KPI
		lineageTag: 03c6afe5-51b3-4005-b8f8-b7a0db67c783

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin' = [Revenue] - [Cost]
		displayFolder: KPI
		lineageTag: 6a38ee08-a3fb-48c4-8c28-04a3ec2fc76c

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin %' = divide([Gross Margin],[Revenue])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI
		lineageTag: 62672df2-8968-49bb-aac9-1ef7a22c1f11

		changedProperty = IsHidden

	measure 'Gross Margin % Previous Year' = ```
			
			VAR PrevGrossMargin = 
			CALCULATE(
			    [Gross Margin %],
			    DATEADD(
			        Calendar[Date],
			        -1,
			        YEAR
			    ))
			RETURN
			    IF(
			        ISBLANK(PrevGrossMargin),0,PrevGrossMargin)
			```
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Previous Year
		lineageTag: 5563a45b-ace6-44eb-9dae-b351bcd489f2

		changedProperty = IsHidden

	measure 'Gross margin Previous Year' = ```
			
			VAR PrevGrossMargin = 
			    CALCULATE(
			        [Gross Margin],
			        DATEADD('Calendar'[Date], -1, YEAR)
			    )
			RETURN
			    IF(ISBLANK(PrevGrossMargin), 0, PrevGrossMargin)
			```
		displayFolder: Previous Year
		lineageTag: 58b935d4-5bdd-4515-a3a8-d6b0b47d4259

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

