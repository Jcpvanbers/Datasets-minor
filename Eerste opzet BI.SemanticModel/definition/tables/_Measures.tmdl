	measure 'Revenue Change vs PY' =
			
			[Revenue] - [Revenue Previous Year]
		displayFolder: YTD
		lineageTag: 9f1031f0-19b2-413d-b254-ac513d2eea3c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue Change vs PY %' =
			
			DIVIDE(
			    [Revenue] - [Revenue Previous Year],
			    [Revenue Previous Year],
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: YTD
		lineageTag: b391a6bc-8883-4ac7-90c9-386e4c27564d

	measure 'Show Subcategory Details' =
			
			IF(
			    ISFILTERED(Productcategory[Product Category]),
			    1,
			    0
			)
		formatString: 0
		displayFolder: Misc
		lineageTag: a9b27803-42e8-47f4-b98e-1d3f710158bc

