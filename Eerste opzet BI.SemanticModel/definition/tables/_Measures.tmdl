	measure 'Trend Chart Title' =
			
			VAR SelectedMetric =
			    MAX('Trend Metric'[Trend Metric])
			RETURN
			    COALESCE(SelectedMetric, "Revenue")
			        & " by Month"
		displayFolder: Titles
