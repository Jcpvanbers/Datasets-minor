	measure 'Sales YTD' = CALCULATE([Revenue],DATESYTD('Calendar'[Date]))
		displayFolder: YTD
		lineageTag: dcaf6ab2-d75f-4950-bda5-b9950e201c8f

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Margin Latest Year' =
			
			VAR LatestYear =
			    MAX(Calendar[Year])
			RETURN
			    CALCULATE(
			        [Gross Margin],
			        REMOVEFILTERS(Calendar[Year]),
			        Calendar[Year] = LatestYear
			    )
		displayFolder: Latest Year
		lineageTag: 30fd7ca0-0927-4070-bd97-c903899e3e86

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'GDP per Capita Latest Year' =
			
			VAR LatestYear =
			    MAX(Calendar[Year])
			RETURN
			    CALCULATE(
			        [GDP per Capita],
			        REMOVEFILTERS(Calendar[Year]),
			        Calendar[Year] = LatestYear
			    )
		displayFolder: Latest Year
		lineageTag: ea4d6a36-696f-4e5f-aa0e-a81b4dd18f00

	measure 'GDP per Capita' =
			
