	measure 'Cost Previous Year' =
			
			VAR PrevCost =
			CALCULATE(
			    [Cost],
			    DATEADD(
			        Calendar[Date],
			        -1,
			        YEAR
			    ))
			Return
			 IF(
			    ISBLANK(PrevCost),0,PrevCost)
		displayFolder: Previous Year
